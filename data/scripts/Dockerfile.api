# The search API (search_api.py) over the pipeline's search service.
#
# The image carries the whole scripts directory because the service imports the
# flat pipeline modules (pipeline_common, search_filters, gemini_auth); nothing
# from the ingestion stages runs here. Built from data/scripts as the context
# by deploy/local/docker-compose.yml.

FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

# Dependencies first, so source edits do not invalidate the layer.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev

COPY *.py ./
COPY sql/ ./sql/

# chunker.py loads the tiktoken encoding at import time and pipeline_common
# imports chunker, so the first import would download the BPE file. Fetch it
# now, into a directory inside the image, so the container starts offline.
ENV TIKTOKEN_CACHE_DIR=/app/.tiktoken
RUN /app/.venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

ENV PYTHONUNBUFFERED=1
EXPOSE 8010

# Run uvicorn from the synced environment directly, so nothing at start-up
# needs the network or tries to re-resolve the lock.
CMD ["/app/.venv/bin/uvicorn", "search_api:app", "--host", "0.0.0.0", "--port", "8010"]
