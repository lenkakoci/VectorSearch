# Data scripts environment. Copy to .env and fill in. Never commit .env.

# --- OpenAI / Azure OpenAI ---
# For plain OpenAI: set OPENAI_API_KEY only.
# For Azure OpenAI with API key: set OPENAI_API_KEY + OPENAI_BASE_URL + OPENAI_API_VERSION.
# For Azure OpenAI with Entra ID: omit OPENAI_API_KEY, set OPENAI_BASE_URL and OPENAI_AUTH_MODE=entra.
OPENAI_API_KEY=sk-your-openai-or-azure-key
OPENAI_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# OPENAI_API_VERSION=preview
# OPENAI_AUTH_MODE=entra

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=geodb
PGUSER=admin
PGPASSWORD=change-me

# --- Pipeline ---
# Input folder with source reports (PDF or Markdown).
REPORTS_INPUT_DIR=../PDFs
# pgvector HNSW indexes support at most 2000 dimensions.
EMBEDDING_DIMENSIONS=2000
EMBEDDING_BATCH_SIZE=100
# Chunker parameters. Changing any of these triggers re-chunking on next ingest.
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=150
# Prepend document metadata to each chunk before embedding (Contextual Retrieval).
CONTEXTUALIZE_CHUNKS=true

LOG_LEVEL=INFO
