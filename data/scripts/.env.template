# Data scripts environment. Copy to .env and fill in. Never commit .env.

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Generation model used for structured extraction.
# gemini-3.7-flash is the current stable flash model; gemini-2.5-pro is the
# slower, more expensive alternative if extraction quality proves insufficient.
GEMINI_MODEL=gemini-3.7-flash

# Embedding model. gemini-embedding-001 is generally available and text-only.
# gemini-embedding-2-preview is multimodal but still in preview.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=geodb
PGUSER=admin
PGPASSWORD=change-me

# --- Pipeline ---
# Input folder with source reports (PDF or Markdown).
REPORTS_INPUT_DIR=../PDFs

# Gemini supports 128-3072 dimensions (recommended tiers: 768, 1536, 3072), but
# a pgvector HNSW index accepts at most 2000. 1536 is the largest recommended
# tier that fits. Changing this REQUIRES editing vector(1536) in
# sql/tables/02_create_document_chunks.sql and recreating the table.
EMBEDDING_DIMENSIONS=1536

# Texts per embedding request. Lower this if the API rejects large batches.
EMBEDDING_BATCH_SIZE=100

# Chunker parameters. Changing any of these triggers re-chunking on next ingest.
# Note: gemini-embedding-001 accepts at most 2048 input tokens per text, and the
# context prefix is added on top of the chunk, so keep CHUNK_MAX_TOKENS well below.
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=150

# Prepend document metadata to each chunk before embedding (Contextual Retrieval).
CONTEXTUALIZE_CHUNKS=true

LOG_LEVEL=INFO
